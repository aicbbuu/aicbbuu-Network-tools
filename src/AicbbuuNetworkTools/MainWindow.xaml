<Window x:Class="AicbbuuNetworkTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AicbbuuNetworkTools.ViewModels"
        Title="Aicbbuu Network Tools"
        Width="1100" Height="720"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Background="{StaticResource BgBaseBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" Padding="12,16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Aicbbuu" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="Bold" Margin="8,0,8,4"/>
                <TextBlock DockPanel.Dock="Top" Text="Network Tools v1.0.0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,0,8,16"/>

                <ListBox SelectedItem="{Binding SelectedModule}" Background="Transparent" BorderThickness="0" Margin="0,4" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}"/>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Width="26" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Border Grid.Column="1" Background="{StaticResource BgBaseBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部模块标题 -->
                <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" Padding="24,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedModule.DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedModule.Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 功能区 -->
                <ContentControl Grid.Row="1" Content="{Binding SelectedModule.ViewInstance}" Margin="16"/>

                <!-- 状态栏 -->
                <Border Grid.Row="2" Background="{StaticResource BgSidebarBrush}" Padding="16,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
