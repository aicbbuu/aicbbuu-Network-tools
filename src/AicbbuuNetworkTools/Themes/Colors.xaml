<!-- 深色现代色板 + 霓虹强调 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <Color x:Key="BgBase">#0A0E1A</Color>
    <Color x:Key="BgSurface">#161B2E</Color>
    <Color x:Key="BgSidebar">#0E1322</Color>
    <Color x:Key="BgElevated">#12182A</Color>
    <Color x:Key="BgHover">#1A2238</Color>

    <!-- 强调 -->
    <Color x:Key="AccentPrimary">#06D6A0</Color>
    <Color x:Key="AccentBlue">#67E8F9</Color>
    <Color x:Key="AccentSoft">#06D6A020</Color>

    <!-- 文字 -->
    <Color x:Key="TextPrimary">#F8FAFC</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextTertiary">#64748B</Color>

    <!-- 边框 -->
    <Color x:Key="BorderSubtle">#2A3045</Color>

    <!-- 画刷 -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebar}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevated}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextTertiary}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />

</ResourceDictionary>
